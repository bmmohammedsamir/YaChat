{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yachat",
  "main": "./worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth/*"]
  }
}
