{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "yachat",
  "main": "./worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./client/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/oauth/*"]
  },
  "containers": [
    {
      "class_name": "LibreChatBackend",
      "image": "./Dockerfile",
      "instance_type": "standard-2",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "LibreChatBackend",
        "name": "BACKEND"
      }
    ]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["LibreChatBackend"]
    }
  ]
}
